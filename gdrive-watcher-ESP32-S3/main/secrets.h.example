/* Copie este arquivo para "secrets.h" (mesma pasta) e preencha com suas
   credenciais reais. "secrets.h" fica fora do git (ver .gitignore) —
   "secrets.h.example" e o unico versionado.

   Pre-requisitos no Google Cloud Console (ver README.md para o passo
   a passo completo): projeto criado, Google Drive API ativada, uma
   chave de API restrita a ela, um client OAuth "TVs e dispositivos com
   entrada limitada" (fluxo device) e um client OAuth "App para
   computador" (fluxo PKCE). */
#ifndef SECRETS_H
#define SECRETS_H

#define WIFI_SSID     "SEU_SSID_AQUI"
#define WIFI_PASSWORD "SUA_SENHA_AQUI"

/* Chave de API (Credenciais > Criar credenciais > Chave de API),
   restrita a "Google Drive API". Usada so para links PUBLICOS
   (nao exige login). */
#define GDRIVE_API_KEY "SUA_API_KEY_AQUI"

/* Client OAuth tipo "TVs e dispositivos com entrada limitada" --
   fluxo "device code" (codigo aparece no terminal do ESP). Escopo
   limitado pelo Google a drive.file (so ve o que o proprio ESP criar). */
#define GOOGLE_CLIENT_ID     "SEU_CLIENT_ID_AQUI.apps.googleusercontent.com"
#define GOOGLE_CLIENT_SECRET "SEU_CLIENT_SECRET_AQUI"

/* Client OAuth tipo "App para computador" -- fluxo PKCE (abre uma URL,
   cola o codigo de volta no terminal). Escopo drive.readonly, ve o
   Drive inteiro da conta. */
#define GOOGLE_DESKTOP_CLIENT_ID     "SEU_CLIENT_ID_DESKTOP_AQUI.apps.googleusercontent.com"
#define GOOGLE_DESKTOP_CLIENT_SECRET "SEU_CLIENT_SECRET_DESKTOP_AQUI"

/* Intervalo padrao de polling, em segundos (ajustavel em runtime via
   o comando "interval"). */
#define POLL_INTERVAL_SECONDS_DEFAULT 300

#endif /* SECRETS_H */
