/* Copie este arquivo para "secrets.h" (mesma pasta) e preencha com suas
   credenciais reais. "secrets.h" fica fora do git (ver .gitignore) —
   "secrets.h.example" e o unico versionado. */
#ifndef SECRETS_H
#define SECRETS_H

#define WIFI_SSID     "SEU_SSID_AQUI"
#define WIFI_PASSWORD "SUA_SENHA_AQUI"

/* mqtt://IP:1883 - o broker MQTT (seu, do professor, ou o publico
   test.mosquitto.org). O broker e o ESP32 precisam estar na mesma
   rede local, a nao ser que seja um broker publico na internet. */
#define MQTT_BROKER_URI "mqtt://SEU_IP_DO_BROKER:1883"

/* Usuario/senha do broker MQTT. Deixe em branco ("") se o broker nao
   exigir autenticacao. */
#define MQTT_USERNAME ""
#define MQTT_PASSWORD ""

#endif /* SECRETS_H */
